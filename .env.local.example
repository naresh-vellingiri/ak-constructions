# Copy to .env.local and fill in real values (see docs/ADMIN-SETUP.md).
# .env.local is gitignored — never commit real secrets.

# --- Supabase (database) ---
# From Supabase → Project Settings → API.
# NOT prefixed NEXT_PUBLIC_: the browser never talks to Supabase directly, and
# the service_role key bypasses Row Level Security, so it must stay server-side.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- NextAuth (admin + client logins) ---
NEXTAUTH_URL=http://localhost:3005
NEXTAUTH_SECRET=
ADMIN_USERNAME=
# Set ONE of the two below (see docs/ADMIN-SETUP.md step 2).
# Plain hash: escape every $ as \$ here, because Next.js expands $ in .env files.
ADMIN_PASSWORD_HASH=
# Base64 of the hash — no escaping needed. Wins over the plain one if both are set.
ADMIN_PASSWORD_HASH_B64=

# --- Optional ---
# Protects /api/health (the Supabase keep-alive cron). Vercel sends this
# automatically as a Bearer token; leave blank locally.
CRON_SECRET=
# Google Analytics 4 Measurement ID (e.g. G-XXXXXXXXXX). Blank disables analytics.
# Build-time inlined — changing it needs a redeploy to take effect.
NEXT_PUBLIC_GA_ID=
# Google Places API (New) key for the plot-location suggestions in the second
# popup. Leave blank and the field still works, suggesting Chennai areas from a
# built-in list. Setup, restrictions and the free allowance: docs/GOOGLE-PLACES-SETUP.md
# Build-time inlined — adding it in Vercel needs a redeploy to take effect.
NEXT_PUBLIC_GOOGLE_PLACES_KEY=
